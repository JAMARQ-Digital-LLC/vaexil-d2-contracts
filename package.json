{
  "name": "@vaexil/d2-contracts",
  "version": "1.0.0",
  "description": "Shared wire types for the Destiny 2 Armor Optimizer and Armory on vaexil.tv.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "UNLICENSED",
  "private": false,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
